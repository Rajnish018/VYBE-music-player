generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UploadOperationType {
  CREATE
  REPLACE_AUDIO
  DELETE_TRACK
  DELETE_AUDIO
  DELETE_COVER
}

enum UploadStatus {
  PENDING
  UPLOADING
  DB_COMMITTING
  COMPLETED
  ROLLING_BACK
  ROLLED_BACK
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites   Favorite[]
  history     PlaybackHistory[]
  playlists   Playlist[]
  savedTracks UserTrack[]
}

model Track {
  id               String @id @default(uuid())
  title            String
  normalizedTitle  String
  artist           String
  normalizedArtist String

  album       String?
  albumArtist String?
  movie       String?

  releaseYear Int?
  releaseDate DateTime?
  language    String?
  explicit    Boolean   @default(false)

  composer    String?
  lyricist    String?
  producer    String?
  remixer     String?
  copyright   String?
  publisher   String?
  description String?

  trackNumber Int?
  discNumber  Int?

  thumbnailUrl  String?
  coverMimeType String?
  coverWidth    Int?
  coverHeight   Int?

  duration Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  musicFiles     MusicFile[]
  genres         TrackGenre[]
  tags           TrackTag[]
  sources        TrackSource[]
  favorites      Favorite[]
  playlistTracks PlaylistTrack[]
  history        PlaybackHistory[]
  artists        TrackArtist[]
  savedBy        UserTrack[]

  @@unique([normalizedTitle, normalizedArtist])
  @@index([normalizedTitle])
  @@index([normalizedArtist])
  @@index([album])
  @@index([albumArtist])
  @@index([movie])
  @@index([releaseYear])
  @@index([language])
}

model UserTrack {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

model MusicFile {
  id         String  @id @default(uuid())
  trackId    String
  megaFileId String?
  megaNodeId String
  fileName   String
  fileSize   Int
  mimeType   String

  audioHash String? @unique

  codec         String?
  bitrate       Int?
  sampleRate    Int?
  bitsPerSample Int?
  channels      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
}

model Genre {
  id             String @id @default(uuid())
  name           String
  normalizedName String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks TrackGenre[]

  @@index([name])
}

model TrackGenre {
  trackId String
  genreId String

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId])
  @@index([genreId])
}

model Tag {
  id             String @id @default(uuid())
  name           String
  normalizedName String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks TrackTag[]

  @@index([name])
}

model TrackTag {
  trackId String
  tagId   String

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([trackId, tagId])
  @@index([tagId])
}

model TrackSource {
  id        String @id @default(uuid())
  trackId   String
  provider  String
  sourceId  String
  sourceUrl String

  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([provider, sourceId])
  @@index([trackId])
  @@index([provider])
  @@index([sourceId])
}

model Playlist {
  id        String   @id @default(uuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistTracks PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String @id @default(uuid())
  playlistId String
  trackId    String
  order      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, order])
  @@index([playlistId])
  @@index([trackId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

model PlaybackHistory {
  id           String   @id @default(uuid())
  userId       String
  trackId      String
  startedAt    DateTime @default(now())
  lastPlayedAt DateTime @default(now()) @updatedAt
  position     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId])
  @@index([lastPlayedAt])
}

model UploadOperation {
  id     String              @id @default(uuid())
  status UploadStatus        @default(PENDING)
  type   UploadOperationType @default(CREATE)

  megaFolder      String?
  megaAudioNodeId String?
  megaCoverNodeId String?

  oldMegaAudioNodeId String?
  oldMegaCoverNodeId String?

  trackId String?
  error   String?

  leaseExpiresAt  DateTime?
  lastHeartbeatAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([trackId])
  @@index([type])
  @@index([leaseExpiresAt])
}

model Artist {
  id             String @id @default(uuid())
  name           String
  normalizedName String @unique

  // Artist-specific information
  description String?

  // Artist-specific image — NOT taken from song cover
  coverUrl       String?
  coverMimeType  String?
  coverUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks TrackArtist[]

  @@index([name])
}

model TrackArtist {
  trackId  String
  artistId String

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
  @@index([artistId])
}
