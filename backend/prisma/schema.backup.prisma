generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  role         Role              @default(USER)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  favorites    Favorite[]
  history      PlaybackHistory[]
  playlists    Playlist[]
}

model Track {
  id               String            @id @default(uuid())
  title            String
  normalizedTitle  String
  artist           String
  normalizedArtist String
  album            String?
  thumbnailUrl     String?
  duration         Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  favorites        Favorite[]
  musicFiles       MusicFile[]
  history          PlaybackHistory[]
  playlistTracks   PlaylistTrack[]
  sources          TrackSource[]

  @@index([normalizedTitle])
  @@index([normalizedArtist])
}

model TrackSource {
  id        String   @id @default(uuid())
  trackId   String
  provider  String
  sourceId  String
  sourceUrl String
  createdAt DateTime @default(now())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([provider, sourceId])
  @@index([provider])
  @@index([sourceId])
}

model MusicFile {
  id         String   @id @default(uuid())
  trackId    String
  megaFileId String?
  megaNodeId String
  fileName   String
  mimeType   String
  fileSize   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId])
}

model Playlist {
  id             String          @id @default(uuid())
  name           String
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlistTracks PlaylistTrack[]
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  trackId    String
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([playlistId])
  @@index([trackId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

model PlaybackHistory {
  id           String   @id @default(uuid())
  userId       String
  trackId      String
  startedAt    DateTime @default(now())
  lastPlayedAt DateTime @default(now()) @updatedAt
  position     Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  track        Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([trackId])
}

enum Role {
  USER
  ADMIN
}
